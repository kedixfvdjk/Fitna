# Copy this file to .env and fill in your Supabase project's public values.
# Find these under Project Settings > API in the Supabase dashboard.
# NEVER put the service_role key here — only the anon/publishable key is
# safe to ship in a client app.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key
